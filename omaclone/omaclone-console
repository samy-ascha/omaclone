#!/bin/sh
# tty1 owner. When the operator quits, the login prompt comes back.
# getty@tty1 conflicts with omaclone-tui, and this unit hangs up tty1
# as it dies. Starting getty from this process deadlocks on that
# conflict or loses the new login to the hangup, and tty1 stays blank.
# Queue the handoff, exit, and let it run only once this unit is inactive.
/usr/local/bin/omaclone
status=$?
systemd-run --no-block --unit=omaclone-getty-return --collect \
    --description=omaclone-getty-return \
    /bin/sh -c 'while systemctl is-active --quiet omaclone-tui.service; do sleep 0.1; done
systemctl unmask getty@tty1.service
systemctl start getty@tty1.service'
exit "$status"
